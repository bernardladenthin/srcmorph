    Fixture project for the plugin integration test (.github/plugin-it.sh).

    This is NOT a reactor module. It is a standalone project that consumes
    net.ladenthin:srcmorph-maven-plugin from the local repository, which is the only way to
    exercise the parts of the plugin that only Maven itself exercises: goal-prefix resolution, the
    srcmorph.* command-line properties, the values Maven injects (the project directory, its source
    and resource directories, its name, version and properties), lifecycle-phase binding, and the
    descriptor that maven-plugin-plugin generates. Every unit test in the plugin module calls Java
    methods directly and can see none of that.

    The plugin is configured by srcmorph.yaml next to this pom, at the default place the plugin
    looks, so the POM names nothing but the goals: the worked example of
    srcmorph-maven-plugin/README.md, which this fixture mirrors.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.ladenthin.it</groupId>
    <artifactId>srcmorph-plugin-it</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>srcmorph plugin integration-test fixture</name>
    <description>Consumes srcmorph-maven-plugin from the local repository through a real Maven lifecycle.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Supplied by .github/plugin-it.sh as -Dsrcmorph.it.version=<reactor version>; the
             default keeps a hand-run from silently resolving some other version. -->
        <srcmorph.it.version>UNSET</srcmorph.it.version>
        <!-- ${it.model} and ${it.aiVersion} of srcmorph.yaml: a project property reaches the
             configuration file, and a -D on the command line overrides it. -->
        <it.model>fixture-model</it.model>
        <it.aiVersion>0.0.0-it</it.aiVersion>
    </properties>

    <build>
        <!-- A resource directory is a subtree when the configuration file names none: Extra.java is
             reachable only through this one. -->
        <resources>
            <resource>
                <directory>src/extra/java</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>net.ladenthin</groupId>
                <artifactId>srcmorph-maven-plugin</artifactId>
                <version>${srcmorph.it.version}</version>
                <executions>
                    <!-- All three phases, each bound to a real lifecycle phase, so the run also
                         proves the goals compose in the order the README documents. -->
                    <execution>
                        <id>it-generate</id>
                        <phase>generate-resources</phase>
                        <goals><goal>generate</goal></goals>
                    </execution>
                    <execution>
                        <id>it-aggregate-packages</id>
                        <phase>process-resources</phase>
                        <goals><goal>aggregate-packages</goal></goals>
                    </execution>
                    <execution>
                        <id>it-aggregate-project</id>
                        <phase>prepare-package</phase>
                        <goals><goal>aggregate-project</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
