<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
    <display-name>shop-backoffice</display-name>

    <context-param>
        <param-name>shop.reportDirectory</param-name>
        <param-value>/var/shop/reports</param-value>
    </context-param>

    <servlet>
        <servlet-name>ReportDownloadServlet</servlet-name>
        <servlet-class>shop.web.ReportDownloadServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportDownloadServlet</servlet-name>
        <url-pattern>/reports/*</url-pattern>
    </servlet-mapping>

    <!--
    <servlet>
        <servlet-name>LegacyExportServlet</servlet-name>
        <servlet-class>shop.web.LegacyExportServlet</servlet-class>
    </servlet>
    -->

    <filter>
        <filter-name>RequestIdFilter</filter-name>
        <filter-class>shop.web.RequestIdFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RequestIdFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <listener>
        <listener-class>shop.web.StartupAuditListener</listener-class>
    </listener>

    <session-config>
        <session-timeout>20</session-timeout>
    </session-config>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>backoffice</web-resource-name>
            <url-pattern>/admin/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>admin</role-name>
        </auth-constraint>
    </security-constraint>
    <security-role>
        <role-name>admin</role-name>
    </security-role>

    <resource-ref>
        <res-ref-name>jdbc/ShopDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
    </resource-ref>
</web-app>
