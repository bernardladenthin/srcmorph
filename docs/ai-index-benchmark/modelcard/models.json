    "openrouter": {
      "provider": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "contextSize": 131072,
      "reasoningEffort": "low"
    },
    "huggingface": {
      "provider": "openai-compatible",
      "baseUrl": "https://router.huggingface.co/v1",
      "apiKeyEnv": "HF_TOKEN",
      "contextSize": 32768
    },
    "local": {
      "provider": "llamacpp-jni",
      "contextSize": 32768,
      "threads": 8,
      "seed": 42
    }
  },
