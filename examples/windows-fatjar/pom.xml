<!--
    Builds target\srcmorph.jar: the srcmorph CLI plus exactly the llama natives this machine needs.
    Run build.bat once, then run.bat. The classifiers below are the only thing to adapt per machine:
    one library jar for the OS/arch (cpu-...) and, optionally, GPU module jars of the same OS/arch.
    The table of classifiers is in the java-llama.cpp README, "Choosing the natives jars".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>local</groupId>
    <artifactId>srcmorph-local</artifactId>
    <version>1</version>
    <packaging>pom</packaging>

    <properties>
        <srcmorph.version>1.3.0-SNAPSHOT</srcmorph.version>
        <llama.version>6.0.0</llama.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Only needed while srcmorph.version is a -SNAPSHOT; delete it once 1.3.0 is on Maven Central. -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>net.ladenthin</groupId>
            <artifactId>srcmorph-cli</artifactId>
            <version>${srcmorph.version}</version>
            <exclusions>
                <!-- the CPU natives of every desktop platform (~100 MiB); the jars below replace it -->
                <exclusion>
                    <groupId>net.ladenthin</groupId>
                    <artifactId>llama-platform</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- the library: jllama.dll, llama/ggml and the CPU backend modules for Windows x86-64 -->
        <dependency>
            <groupId>net.ladenthin</groupId>
            <artifactId>llama</artifactId>
            <version>${llama.version}</version>
            <classifier>cpu-windows-x86-64</classifier>
        </dependency>
        <!-- optional GPU module: any GPU with a Vulkan driver (Intel Arc/iGPU, AMD, NVIDIA).
             Without a working driver ggml skips it and runs on the CPU. -->
        <dependency>
            <groupId>net.ladenthin</groupId>
            <artifactId>llama</artifactId>
            <version>${llama.version}</version>
            <classifier>vulkan-windows-x86-64</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>srcmorph</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <archive>
                        <manifest>
                            <mainClass>net.ladenthin.srcmorph.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
