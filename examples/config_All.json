{
  "command": "All",
  "packageFieldGenerations": [
    {
      "promptKey": "package-body",
      "aiDefinitionKey": "mock-model"
    }
  ],
  "projectFieldGenerations": [
    {
      "promptKey": "project-body",
      "aiDefinitionKey": "mock-model"
    }
  ],
  "srcMorph": {
    "baseDirectory": ".",
    "outputDirectory": "target/srcmorph-ai",
    "subtrees": [
      "src/main/java"
    ],
    "fileExtensions": [
      ".java"
    ],
    "excludes": [
      "**/package-info.java"
    ],
    "generationProvider": "mock",
    "projectName": "my-project",
    "profileDirectory": "../profiles/v3",
    "aiDefinitions": [
      {
        "key": "mock-model",
        "modelPath": "unused-with-mock-provider.gguf",
        "contextSize": 4096,
        "maxOutputTokens": 64,
        "temperature": 0.15,
        "threads": 2
      }
    ],
    "fieldGenerations": [
      {
        "id": "java",
        "promptKey": "file-body-oop",
        "aiDefinitionKey": "mock-model",
        "condition": {
          "extensions": [
            ".java"
          ]
        }
      },
      {
        "id": "fallback",
        "fallback": true,
        "promptKey": "file-body-fallback",
        "aiDefinitionKey": "mock-model"
      }
    ]
  }
}
