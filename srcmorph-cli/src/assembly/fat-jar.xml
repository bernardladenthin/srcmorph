<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <!--
      Same output as the predefined jar-with-dependencies descriptor, plus two fileSets.

      The dependencySet below is a verbatim copy of the predefined descriptor shipped
      inside maven-assembly-plugin: outputDirectory /, useProjectArtifact true,
      unpack true, scope runtime. Keep it that way; the only reason this file exists at
      all is the fileSet underneath it.

      The first adds simplelogger.properties, which cannot live in src/main/resources:
      from there it would be published in the srcmorph-cli jar and land on the classpath
      of anyone embedding it, where slf4j-simple would read it instead of theirs. Only the
      runnable artifact may carry logging defaults. The second adds the dependencies' legal
      files, for the same reason: they belong to what the fat jar bundles, not to srcmorph-cli.

      Kept in the same shape as BitcoinAddressFinder's src/assembly/fat-jar.xml.
    -->
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/src/main/assembly-resources</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>simplelogger.properties</include>
            </includes>
        </fileSet>
        <!-- The legal files of every runtime dependency, collected by the collect-runtime-licenses
             execution into target/third-party-dependencies (not into target/classes, so the
             library jar never carries them). They describe the dependencies this jar bundles. -->
        <fileSet>
            <directory>${project.build.directory}/third-party-dependencies</directory>
            <outputDirectory>META-INF/third-party/dependencies</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
